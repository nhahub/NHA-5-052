   # Copy this file to .env (same folder as docker-compose.yaml) and change the passwords.
   # .env is in .gitignore, so real passwords are never pushed to GitHub.
   AIRFLOW_UID=50000

   MYSQL_ROOT_PASSWORD=rootpassword
   MYSQL_USER=oltp_user
   MYSQL_PASSWORD=oltp_password

   DW_USER=dw_user
   DW_PASSWORD=dw_password

   MONGO_USER=mongo_admin
   MONGO_PASSWORD=mongo_password

   # Contact shown in the scrapers' User-Agent (Jumia requires an owner contact for bots)
   SCRAPER_CONTACT=team-email@example.com
